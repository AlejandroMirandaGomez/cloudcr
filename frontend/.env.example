# Copiar a frontend/.env (que ya esta en .gitignore por *.local / .env de Vite).

# URL base del API. En desarrollo con el backend local:
VITE_API_URL=http://localhost:8000

# Fase 2 - Monitor de Salud: cada cuantos milisegundos el dashboard vuelve a
# consultar el API. Por defecto 5000. Para la demostracion en vivo, 3000,
# y bajar tambien INTERVALO_SEGUNDOS en collector/.env.
VITE_MONITOR_REFRESCO_MS=5000
