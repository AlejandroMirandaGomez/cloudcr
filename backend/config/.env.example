# Copiar este archivo a config/.env y ajustar los valores.
# Si config/.env no existe, se usan los valores por defecto de app/Core/Config.php.
# Las variables de entorno reales del sistema tienen prioridad sobre este archivo.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_cr
DB_USER=postgres
DB_PASS=postgres
# prefer = usa SSL si el servidor lo ofrece (Neon, etc.), sin romper Postgres local sin SSL.
# Para forzarlo (ej. produccion) usar require.
DB_SSLMODE=prefer

# true = los errores incluyen detalle tecnico en la respuesta JSON. Poner false en produccion.
APP_DEBUG=true

# Origen permitido para CORS. Con "*" no se pueden enviar cookies de sesion:
# cuando exista autenticacion habra que fijar el origen exacto del frontend
# (por ejemplo http://localhost:5173).
CORS_ORIGIN=*

# --- Fase 2: Monitor de Salud -------------------------------------------
# Secreto compartido con el collector local (collector/), que lo manda en la
# cabecera X-Collector-Token al hacer POST /monitor/ingesta. Minimo 16
# caracteres. Sin este valor la ingesta queda cerrada (responde 503).
# Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOR_COLLECTOR_TOKEN=
