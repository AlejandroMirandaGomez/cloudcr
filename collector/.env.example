# Copiar a collector/.env y completar. collector/.env esta en .gitignore.

# URL base del backend de CloudCR (sin barra final).
# Produccion: https://<servicio>.onrender.com
# Local:      http://localhost:8000
MONITOR_API_URL=http://localhost:8000

# Debe coincidir EXACTAMENTE con MONITOR_COLLECTOR_TOKEN del backend.
# Generar uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOR_COLLECTOR_TOKEN=

# Segundos entre ciclos. Para el demo en vivo se recomienda 2 o 3.
INTERVALO_SEGUNDOS=5

# Puerto del API local del collector (solo escucha en 127.0.0.1).
COLLECTOR_PUERTO=8100

# Reintentos por envio fallido y timeout de cada peticion HTTP.
REINTENTOS=2
TIMEOUT_SEGUNDOS=15
