# Copiar a agente_local/.env. Ese archivo esta en .gitignore.

# API local del collector (el agente local le reenvia el registro de bases).
COLLECTOR_URL=http://127.0.0.1:8100

# Puerto donde se sirve la pagina del agente local.
AGENTE_LOCAL_PUERTO=8200

TIMEOUT_SEGUNDOS=20

# SALVAGUARDA: por defecto el stress solo corre contra localhost/127.0.0.1.
# Poner true unicamente si la base de PRUEBA esta en otra maquina.
# Nunca apuntar el stress a una base con datos reales.
PERMITIR_REMOTO=false
